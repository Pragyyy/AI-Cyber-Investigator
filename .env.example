# Copy this file to .env and fill in your own values. Never commit .env.

# --- Backend (Phase 1) ---
DB_PATH=data/investigator.db
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- RAG (Phase 4). Defaults match the project brief's recommended stack. ---
# Set both to tfidf/memory for a lighter, fully-offline mode (see requirements.txt).
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_VECTOR_BACKEND=chroma
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_PERSIST_DIR=data/rag_index
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# --- LLM (used from Phase 5 onward; leave blank for now) ---
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- Multi-agent graph (Phase 5) ---
# "langgraph" is recommended and used by default; falls back to "sequential"
# automatically if langgraph isn't installed. Both run identical agent logic.
AGENT_GRAPH_BACKEND=langgraph
